<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(TINYUSAGE_BACKGROUND_REFRESH_IDENTIFIER)</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>TinyUsage</string>
	<key>TinyUsageAppGroupIdentifier</key>
	<string>$(TINYUSAGE_APP_GROUP)</string>
	<key>TinyUsageBackgroundRefreshIdentifier</key>
	<string>$(TINYUSAGE_BACKGROUND_REFRESH_IDENTIFIER)</string>
	<key>TinyUsageKeychainNamespace</key>
	<string>$(TINYUSAGE_KEYCHAIN_NAMESPACE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(TINYUSAGE_BUNDLE_PREFIX).TinyUsage</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tinyusage</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_tinyusage._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Scan the temporary pairing QR code shown by TinyUsage Collector on your Mac.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Find your paired TinyUsage Collector and synchronize usage snapshots on your local network.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
